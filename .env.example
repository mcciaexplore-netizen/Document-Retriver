# Docker Compose reads a root .env. Defaults also allow an immediate local demo.
# Change the bootstrap credentials before an enterprise deployment.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_DB=mccia
POSTGRES_USER=mccia
POSTGRES_PASSWORD=mccia_local_dev

ADMIN_EMAIL=admin@mccia.org
ADMIN_PASSWORD=Mccia@2026!
MANAGER_PASSWORD=Manager@2026!
VIEWER_PASSWORD=Viewer@2026!
DEMO_SEED=true
# New accounts receive an isolated private workspace; shared access requires an admin.
# Unset defaults to DEMO_SEED; set false for administrator-only provisioning.
# ALLOW_REGISTRATION=true

# Browser sessions: set COOKIE_SECURE=true when served over HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=12
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
SEARCH_RESULT_LIMIT=100
AUDIT_RETENTION_DAYS=365

# Optional local (non-Docker) overrides. Compose supplies its own container paths.
# DATABASE_URL=sqlite:///./mccia.db
# STORAGE_PATH=./storage
# BACKEND_URL=http://127.0.0.1:8000
