# Copy to .env for local development. Never put real production secrets here.
# FRONTEND_PORT and BACKEND_PORT are published on your computer.
FRONTEND_PORT=3000
BACKEND_PORT=8001
# Exact browser origins only. Update the ports here if FRONTEND_PORT changes.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
DEMO_SEED=true
ALLOW_REGISTRATION=true

# Native local runs use root mccia.db (SQLite) and root storage/ by default.
# Leave DATABASE_URL unset here: setting a local SQLite URL in this shared file
# would also override Docker Compose's PostgreSQL connection.
# BACKEND_URL is derived from BACKEND_PORT for local startup. Docker supplies
# http://backend:8000 internally. Set BACKEND_URL only for a separate frontend.

# Optional Docker Compose overrides. Local-only defaults work when unset.
# POSTGRES_DB=mccia
# POSTGRES_USER=mccia
# POSTGRES_PASSWORD=choose-a-private-local-password

# For a private non-demo database, set DEMO_SEED=false, ALLOW_REGISTRATION=false,
# and supply ADMIN_EMAIL and a strong ADMIN_PASSWORD before first startup.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-private-password

# Optional backend limits (defaults shown):
# SESSION_HOURS=12
# MAX_UPLOAD_MB=25
# SEARCH_RESULT_LIMIT=100
# AUDIT_RETENTION_DAYS=365
