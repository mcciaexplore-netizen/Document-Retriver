# Reference only. Put these values in the Render/Vercel dashboards, not a
# deployed .env file. Never commit actual passwords or database URLs.

# Render backend (the current Blueprint already supplies SQLite disk paths):
DEMO_SEED=false
ALLOW_REGISTRATION=false
COOKIE_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-private-password
CORS_ORIGINS=https://your-frontend.vercel.app
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# STORAGE_PATH=/app/storage

# Vercel frontend only, set before building and redeploy after a change:
# BACKEND_URL=https://your-api.onrender.com
